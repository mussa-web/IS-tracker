DATABASE_URL=postgresql://stockroom_app:URL_ENCODED_PASSWORD@localhost:5432/stockroom
SESSION_SECRET=GENERATE_A_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES_LONG
PORT=8000
APP_BASE_URL=http://localhost:8000

# Automated PostgreSQL backups (first backup at startup, then daily; keep 14).
# Defaults to %LOCALAPPDATA%\Stockroom\backups on Windows.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
# BACKUP_DIR=C:\StockroomBackups
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# Mailjet HTTPS API credentials (preferred on hosts that block outbound SMTP).
# When both are set, Stockroom sends through api.mailjet.com over HTTPS (port 443).
# MAILJET_API_KEY=YOUR_MAILJET_API_KEY
# MAILJET_API_SECRET=YOUR_MAILJET_SECRET_KEY
# SMTP_FROM=Stockroom <verified-sender@example.com>

# Or use SMTP credentials from your email provider (use an app password if required).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=stockroom@example.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=Stockroom <stockroom@example.com>
